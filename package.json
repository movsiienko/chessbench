    "@workflow/vitest": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "oxlint": "1.81.0",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
